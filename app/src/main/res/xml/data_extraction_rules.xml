<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Same policy as backup_rules.xml for cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="varagh_token_keyset_prefs.xml" />
        <exclude domain="file" path="datastore/auth_tokens.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="varagh_token_keyset_prefs.xml" />
        <exclude domain="file" path="datastore/auth_tokens.preferences_pb" />
    </device-transfer>
</data-extraction-rules>

<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower. Library data, covers and settings are backed up; login tokens and their
     Keystore-bound keyset are not (they cannot be decrypted on another device anyway). -->
<full-backup-content>
    <exclude domain="sharedpref" path="varagh_token_keyset_prefs.xml" />
    <exclude domain="file" path="datastore/auth_tokens.preferences_pb" />
</full-backup-content>

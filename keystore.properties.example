# Copy to keystore.properties (git-ignored) to sign release builds with your upload key.
# Create a key once with:
#   keytool -genkeypair -v -keystore varagh-upload.jks -alias varagh -keyalg RSA -keysize 4096 -validity 10000
storeFile=varagh-upload.jks
storePassword=change-me
keyAlias=varagh
keyPassword=change-me
